{
  "name": "pomodoro-timer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pomodoro/web",
    "build": "npm run build -w @pomodoro/protocol && npm run build -w @pomodoro/core && npm run build -w @pomodoro/service && npm run build -w @pomodoro/api && npm run build -w @pomodoro/client && npm run build -w @pomodoro/cli && npm run build -w @pomodoro/web",
    "build:protocol": "npm run build -w @pomodoro/protocol",
    "build:core": "npm run build -w @pomodoro/core",
    "build:service": "npm run build -w @pomodoro/service",
    "build:api": "npm run build -w @pomodoro/api",
    "build:client": "npm run build -w @pomodoro/client",
    "build:cli": "npm run build -w @pomodoro/cli",
    "build:web": "npm run build -w @pomodoro/web",
    "pomodoro": "node packages/cli/dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
